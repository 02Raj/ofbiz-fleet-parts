<entity-engine-xml>
    <!-- Existing OFBiz group permissions for this component -->
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FULLADMIN" permissionId="HEAVYEQUIPMENT_ADMIN"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FLEXADMIN" permissionId="HEAVYEQUIPMENT_CREATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FLEXADMIN" permissionId="HEAVYEQUIPMENT_DELETE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FLEXADMIN" permissionId="HEAVYEQUIPMENT_UPDATE"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="FLEXADMIN" permissionId="HEAVYEQUIPMENT_VIEW"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="VIEWADMIN" permissionId="HEAVYEQUIPMENT_VIEW"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="BIZADMIN" permissionId="HEAVYEQUIPMENT_ADMIN"/>

    <!-- ==================== Custom Security Groups ==================== -->

    <!-- Tenant Admin: Full access to their tenant's data -->
    <SecurityGroup groupId="HE_TENANT_ADMIN" groupName="HE Tenant Administrator" description="Full access to tenant operations"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_TENANT_ADMIN" permissionId="HEAVYEQUIPMENT_ADMIN"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_TENANT_ADMIN" permissionId="HEAVYEQUIPMENT_TENANT_ADMIN"/>

    <!-- Inventory Manager -->
    <SecurityGroup groupId="HE_INVENTORY_MGR" groupName="HE Inventory Manager" description="Inventory and stock management"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_INVENTORY_MGR" permissionId="HEAVYEQUIPMENT_VIEW"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_INVENTORY_MGR" permissionId="HEAVYEQUIPMENT_INVENTORY"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_INVENTORY_MGR" permissionId="HEAVYEQUIPMENT_WAREHOUSE"/>

    <!-- Warehouse Operator -->
    <SecurityGroup groupId="HE_WAREHOUSE_OPS" groupName="HE Warehouse Operator" description="Receiving, picking, put-away, scanning"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_WAREHOUSE_OPS" permissionId="HEAVYEQUIPMENT_VIEW"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_WAREHOUSE_OPS" permissionId="HEAVYEQUIPMENT_WAREHOUSE"/>

    <!-- Procurement Manager -->
    <SecurityGroup groupId="HE_PROCUREMENT" groupName="HE Procurement Manager" description="Suppliers, POs, purchasing"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_PROCUREMENT" permissionId="HEAVYEQUIPMENT_VIEW"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_PROCUREMENT" permissionId="HEAVYEQUIPMENT_PROCUREMENT"/>

    <!-- Fleet/Maintenance Manager -->
    <SecurityGroup groupId="HE_MAINTENANCE" groupName="HE Maintenance Manager" description="Equipment, work orders, fleet"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_MAINTENANCE" permissionId="HEAVYEQUIPMENT_VIEW"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_MAINTENANCE" permissionId="HEAVYEQUIPMENT_MAINTENANCE"/>

    <!-- Technician -->
    <SecurityGroup groupId="HE_TECHNICIAN" groupName="HE Technician" description="Work order parts requests, issue/return"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_TECHNICIAN" permissionId="HEAVYEQUIPMENT_VIEW"/>
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_TECHNICIAN" permissionId="HEAVYEQUIPMENT_MAINTENANCE"/>

    <!-- Tenant Admin also needs VIEW for webapp access checks -->
    <SecurityGroupPermission fromDate="2001-05-13 12:00:00.0" groupId="HE_TENANT_ADMIN" permissionId="HEAVYEQUIPMENT_VIEW"/>

</entity-engine-xml>
