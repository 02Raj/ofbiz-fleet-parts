          "productId": { "type": "string" },
          "crossRefType": { "type": "string", "enum": ["OEM", "MANUFACTURER", "SUPPLIER", "ALTERNATE", "SUPERSEDED", "CUSTOMER"] },
          "crossRefPartNumber": { "type": "string" },
          "crossRefBrand": { "type": "string" },
          "crossRefProductId": { "type": "string" },
          "notes": { "type": "string" }
        }
      },
      "InventoryLevel": {
        "type": "object",
        "properties": {
          "productId": { "type": "string" },
          "facilityId": { "type": "string" },
          "quantityOnHandTotal": { "type": "number", "description": "Total physical quantity in warehouse" },
          "availableToPromiseTotal": { "type": "number", "description": "Quantity available for allocation (QOH minus reserved)" }
        }
      },
      "Error": {
